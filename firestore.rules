rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'createdAt', 'email', 'displayName', 'photoURL']) &&
        data.uid == request.auth.uid &&
        data.createdAt == request.time &&
        (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email']);
      allow delete: if false;

      // Subcollection: Persistent User Downloads
      match /downloads/{downloadId} {
        function isValidDownloadRecord(data) {
          return data.keys().hasAll(['id', 'userId', 'url', 'title', 'platform', 'quality', 'downloadedAt']) &&
            data.keys().hasOnly(['id', 'userId', 'url', 'title', 'platform', 'thumbnail', 'quality', 'isAiEnhanced', 'aiPreset', 'downloadedAt']) &&
            data.id is string && data.id.size() <= 128 &&
            data.userId == request.auth.uid &&
            data.url is string && data.url.size() <= 2048 &&
            data.title is string && data.title.size() <= 300 &&
            data.platform in ['youtube', 'tiktok', 'facebook', 'instagram', 'twitter', 'other'] &&
            data.quality is string && data.quality.size() <= 64 &&
            data.downloadedAt == request.time &&
            (!('thumbnail' in data) || (data.thumbnail is string && data.thumbnail.size() <= 2048)) &&
            (!('isAiEnhanced' in data) || data.isAiEnhanced is bool) &&
            (!('aiPreset' in data) || data.aiPreset in ['none', 'ultra_hd_upscale', 'denoise_sharpen', 'hdr_color_vivid', 'face_clarity']);
        }

        allow get: if isOwner(userId) && isValidId(downloadId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(downloadId) && isValidDownloadRecord(incoming());
        allow update: if false; // Download logs are append-only/immutable
        allow delete: if isOwner(userId) && isValidId(downloadId);
      }
    }

    // App Settings & Owner profile (Hasan Mahmud)
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
